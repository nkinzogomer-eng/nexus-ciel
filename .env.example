# Persistence (PostgreSQL is recommended for long-running missions)
NEXUS_DATABASE_URL=postgresql://nexus:change-me@localhost:5432/nexus_ciel

# Real OpenAI-compatible provider. For local Ollama, use e.g.:
NEXUS_LLM_BASE_URL=http://localhost:11434/v1
NEXUS_LLM_MODEL=qwen2.5:7b
NEXUS_LLM_STAGE=large_model
NEXUS_LLM_TIMEOUT_S=60
NEXUS_LLM_MAX_TOKENS=2048
NEXUS_LLM_ROUTING_CONFIDENCE=0.80

# Leave the API key empty for a local endpoint. Never commit real secrets.
NEXUS_LLM_API_KEY=

# Local endpoint defaults to zero cost. Hosted endpoints MUST declare prices.
# Values are USD per 1,000 tokens. A shared price can be used instead.
NEXUS_LLM_INPUT_COST_PER_1K_TOKENS=0.0
NEXUS_LLM_OUTPUT_COST_PER_1K_TOKENS=0.0

# Never set NEXUS_TEST_MODE in production; it enables synthetic test providers.
# NEXUS_TEST_MODE=1
